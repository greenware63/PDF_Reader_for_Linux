{
  "name": "Linux PDF Reader Workstation (Ubuntu 24.04)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "ubuntu",
  "containerEnv": {
    "QT_QPA_PLATFORM": "offscreen",
    "CI": "1",
    "BUILD_ROOT": "/home/ubuntu/build"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt",
    "seccomp=unconfined",
    "--shm-size=1g"
  ],
  "mounts": [
    "source=pdf-reader-build-volume,target=/home/ubuntu/build,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
